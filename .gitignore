# Python
__pycache__/
*.pyc
*.pyo

# Backend virtual environment (regenerated by install.sh)
backend/venv/

# Runtime data / secrets — never commit these
backend/app/cerberus-asf.db
backend/app/cerberus-asf.db-wal
backend/app/cerberus-asf.db-shm
backend/app/.instance_secret

# Frida agent build artifacts (regenerated by agent/build.sh)
agent/node_modules/
agent/dist/

# Device-specific frida-server binary (download the version matching your
# client per INSTALL.md — not tracked here since it's large and per-device)
frida-server-*-android-*

# Vendored third-party tool with its own upstream git repo — not part of
# Cerberus-ASF and not currently wired into the app; kept locally, not tracked
backend/fridump/

# Editor / OS
.DS_Store
.vscode/
*.swp

# Local Claude Code tooling config — not part of the project
.claude/

# Superseded documentation for the project's earlier name/version — replaced
# by Cerberus-ASF_Technical_Documentation.docx
WTFAndroid_Technical_Documentation.docx
